{
  "name": "prompt-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "dev": "node build.mjs && vite --host 127.0.0.1 --port 8787",
    "setup:dev": "node scripts/setup-dev.mjs",
    "deploy:cf": "npm run build && cf deploy"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "katex": "^0.19.0",
    "marked": "^16.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.1",
    "cf": "1.0.0-beta.18",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261012.1-beta",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "cloudflare": {
    "bindings": {
      "VAULTS": {
        "description": "存放加密的当前工作区与最近 100 个旧状态。"
      },
      "ACCESS_CONTROL": {
        "description": "保存密码校验、会话与数据密钥、IP 封禁和白名单。请勿删除此 Durable Object。"
      },
      "ACCESS_PASSWORD": {
        "description": "网站访问密码，直接在这里设置，至少 12 字符（最多 512 字符）。部署后用此密码登录，无需初始化码或网页首次设置。请使用独一无二的长密码，并作为 Secret 保存。"
      }
    }
  }
}
